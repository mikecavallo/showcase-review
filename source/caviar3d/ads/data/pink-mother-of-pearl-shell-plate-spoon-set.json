{"product":{"id":7413077573675,"title":"Pink Mother of Pearl Shell Plate Spoon SET","body_html":"\u003cp\u003eBeautiful hand-made and polished pink mother of pearl shell dish, with 3 silver-plated rounded \"feet\" for stability. Includes a matching modern-style pink mother of pearl caviar spoon to make the perfect set.\u003c\/p\u003e\n\u003cp\u003eGreat for serving your caviar in style or any other small, plated foods. Can also be used as a salt or pepper dish, a soap dish, or as a \"catch all\" for jewelry.\u003c\/p\u003e\n\u003cp\u003eDue to the hand-made nature and natural shell variation, each dish will very slightly from the image. Oval shapes measuring ~10-16 cm in width, ~20-28 cm in length. About the size of a large hand. \u003c\/p\u003e\n\u003cp\u003eIncludes 1 shell plate and 1 shell spoon.\u003c\/p\u003e","vendor":"Caviar Star","product_type":"physical","created_at":"2025-07-11T04:06:38-04:00","handle":"pink-mother-of-pearl-shell-plate-spoon-set","updated_at":"2026-10-06T06:18:52-04:00","published_at":"2025-07-11T04:06:38-04:00","template_suffix":null,"published_scope":"global","tags":"By_Country, Catch All, Caviar Palette, Caviar Plate, Dish, MOP, Mother of Pearl, Palette, Pink, Plate, Serving Palette, Serving ware, Shell Dish, Shell Plate","variants":[{"id":41890865774635,"product_id":7413077573675,"title":"Default Title","price":"30.00","sku":"U-D MOP PSET","position":1,"compare_at_price":"49.00","fulfillment_service":"manual","inventory_management":"shopify","option1":"Default Title","option2":null,"option3":null,"created_at":"2025-07-11T04:06:38-04:00","updated_at":"2026-10-06T06:18:52-04:00","taxable":false,"barcode":"713336009424","grams":163,"image_id":35100670591019,"weight":0.36,"weight_unit":"lb","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"USD","compare_at_price_currency":"USD","quantity_price_breaks":[]}],"options":[{"id":9479483260971,"product_id":7413077573675,"name":"Title","position":1,"val