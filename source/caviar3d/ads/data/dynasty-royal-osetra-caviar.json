{"product":{"id":7413063516203,"title":"Dynasty Royal Osetra Caviar","body_html":"\u003cdiv\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 10pt;\"\u003eTrue Osetra caviar, known for its creamy texture and nutty flavor, is one of the finest sturgeon roes in the world. The Russian Sturgeon, originally from the Caspian Sea, Black Sea, and Azov River basins, is now sustainably farmed across its native continent for the exquisite eggs it produces. This beautiful amber-colored Osetra caviar comes from Russian Sturgeon raised in the Thousand Island Lakes of Northern China, at the renowned Kaluga Queen farm. The cool, pristine environment is ideal for producing exceptional caviar at an outstanding price point. Nutty, buttery, perfectly briny, with just the right amount of \"pop\". \u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 10pt;\"\u003eEach jar is hand-packed and carefully inspected for optimal color, size, freshness, flavor, and texture. For additional details on shipping, usage, and privacy policies, please visit our Policy Page \u003c\/span\u003e\u003ca href=\"\/pages\/policies\" style=\"font-size: 10pt;\"\u003ePolicy Page\u003c\/a\u003e\u003cspan style=\"font-size: 10pt;\"\u003e.\u003c\/span\u003e\u003cstrong\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/div\u003e","vendor":"Caviar Star","product_type":"physical","created_at":"2025-07-11T03:54:56-04:00","handle":"dynasty-royal-osetra-caviar","updated_at":"2026-10-06T06:18:40-04:00","published_at":"2025-07-11T03:54:56-04:00","template_suffix":"caviar-variants","published_scope":"global","tags":"Amber, Best Caviar, Black Caviar, By_Country, Caviar, Imported Caviar, Osetra, Osetra Caviar, Ossetra, Royal Caviar, Sturgeon, Sturgeon Caviar","variants":[{"id":41890751741995,"product_id":7413063516203,"title":"1oz","price":"99.00","sku":"OA1","position":1,"compare_at_price":"99.00","fulfillment_service":"manual","inventory_management":"shopify","option1